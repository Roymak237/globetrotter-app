// Deployment pipeline for the KamerGo travel app.
//
// Frontend and backend live in one repository, so a single `checkout scm`
// supplies both and the two always build from the same commit. The Flutter
// app sits under frontend/ rather than at the workspace root, so container
// working directories and the publish step qualify their paths accordingly.
//
// Jenkins runs on the VPS with the host Docker socket mounted, so build
// toolchains run in sibling containers and no SDK is installed into Jenkins
// itself. The live deployment directory is bind mounted at the same absolute
// path it has on the host, which keeps Compose bind mounts valid on both sides.
pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 75, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '15'))
        skipDefaultCheckout(true)
    }

    triggers {
        pollSCM('H/5 * * * *')
    }

    environment {
        APP_DIR        = '/home/mc/project/globetrotter-app'
        DOMAIN         = 'kamer-go.duckdns.org'
        APP_PORT       = '6003'
        JENKINS_VOLUME = 'kamergo-ci_jenkins_home'
        // Must match the SDK the app is developed against. Older images ship a
        // Dart version that the dependency tree rejects.
        FLUTTER_IMAGE  = 'ghcr.io/cirruslabs/flutter:3.41.6'
        PYTHON_IMAGE   = 'python:3.11-slim'
        // Path to the Flutter app, relative to the workspace root.
        APP_ROOT       = 'frontend'

        // Build containers are capped, and capped without swap.
        //
        // This host is shared with a database, several unrelated sites and
        // Jenkins itself, and it has about 5.8 GB free against a 2 GB swapfile
        // that is already half consumed by long-idle processes. An unbounded
        // build does not simply fail when it overreaches: the kernel picks a
        // victim by badness score, and the largest resident process on the box
        // need not be the build. Capping confines the damage to the thing at
        // fault.
        //
        // Setting the swap ceiling equal to the memory ceiling denies these
        // containers swap entirely. A build that overruns then dies at once
        // rather than thrashing a swapfile the live services depend on. A
        // fast, legible failure is worth more here than a slow one that
        // degrades everything else on the way down.
        //
        // MEM_ANDROID is paired with the heaps in android/gradle.properties.
        // An earlier 4 GB proved too tight, and measuring a live build showed
        // why: the Gradle daemon held 2213 MB against an -Xmx of 1536m, and
        // Kotlin had forked two compiler JVMs of 775 MB and 661 MB rather than
        // the one assumed. Heaps were budgeted; native overhead and process
        // count were not.
        //
        // With Kotlin compiling in-process the two extra JVMs disappear, which
        // is worth more than the larger Gradle heap that replaces them. The
        // ceiling below sits roughly a gigabyte above measured demand, so an
        // ordinary build never approaches it while a runaway still stops.
        MEM_ANDROID    = '4608m'
        MEM_FLUTTER    = '3g'
        MEM_PYTHON     = '1g'
    }

    stages {
        stage('Checkout') {
            steps {
                // A previous build that died mid-stage can leave root-owned
                // files behind, and git cannot delete what it does not own, so
                // the checkout fails before a single line of this pipeline
                // runs. Reclaiming first makes the build able to recover from
                // its own wreckage instead of needing a hand on the server.
                sh '''#!/usr/bin/env bash
set -uo pipefail

[ -d "${WORKSPACE}" ] || exit 0

docker run --rm \
    -v "${JENKINS_VOLUME}:/var/jenkins_home" \
    "${PYTHON_IMAGE}" \
    chown -R "$(id -u):$(id -g)" "${WORKSPACE}" || true
'''

                // One repository supplies the Flutter app, the backend, this
                // Jenkinsfile and everything under frontend/deploy/.
                checkout scm

                sh '''#!/usr/bin/env bash
set -euo pipefail
echo "building $(git rev-parse --short HEAD) on $(git rev-parse --abbrev-ref HEAD)"
'''
            }
        }

        stage('Backend checks') {
            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail

# Runs against a throwaway data directory so neither the checkout nor the live
# volume is touched by test writes.
docker run --rm \
    --memory "${MEM_PYTHON}" --memory-swap "${MEM_PYTHON}" \
    -v "${JENKINS_VOLUME}:/var/jenkins_home" \
    -w "${WORKSPACE}" \
    -e PIP_DISABLE_PIP_VERSION_CHECK=1 \
    "${PYTHON_IMAGE}" \
    bash -c '
set -euo pipefail
pip install --quiet --no-cache-dir -r backend/requirements.txt
python - <<"PY"
import os, secrets, shutil, sys, tempfile
from pathlib import Path

source = Path("backend").resolve()
with tempfile.TemporaryDirectory() as tmp:
    root = Path(tmp)
    shutil.copytree(source / "app", root / "app",
                    ignore=shutil.ignore_patterns("__pycache__", "*.pyc"))
    (root / "data").mkdir()
    shutil.copyfile(source / "data/destinations.json", root / "data/destinations.json")
    for name in ("users", "itineraries", "shares"):
        (root / f"data/{name}.json").write_text("[]", encoding="utf-8")

    sys.path.insert(0, str(root))
    os.environ["SECRET_KEY"] = secrets.token_hex(32)
    from app import create_app, models

    assert Path(models.DATA_DIR).resolve() == root / "data", "Test data isolation failed"

    app = create_app()
    app.config["TESTING"] = True
    client = app.test_client()

    assert client.get("/healthz").get_json() == {"status": "ok"}

    listing = client.get("/api/destinations")
    assert listing.status_code == 200 and len(listing.get_json()) > 0

    assert client.get("/api/auth/me").status_code == 401

    creds = {"username": "ci_check", "password": secrets.token_urlsafe(20)}
    assert client.post("/api/auth/register", json=creds).status_code == 201
    login = client.post("/api/auth/login", json=creds)
    assert login.status_code == 200
    token = login.get_json()["token"]
    auth = {"Authorization": "Bearer " + token}
    assert client.get("/api/auth/me", headers=auth).status_code == 200

    # Smoke test for the community layer. The stores for these start empty on
    # a fresh data directory, which is exactly the state a first deploy sees.
    dest_id = listing.get_json()[0]["id"]

    posted = client.post(f"/api/destinations/{dest_id}/comments",
                         json={"text": "ci smoke"}, headers=auth)
    assert posted.status_code == 201, posted.get_data(as_text=True)
    comment_id = posted.get_json()["id"]
    assert client.post(f"/api/comments/{comment_id}/vote",
                       json={"value": 1}, headers=auth).status_code == 200
    thread = client.get(f"/api/destinations/{dest_id}/comments", headers=auth)
    assert thread.status_code == 200 and len(thread.get_json()) == 1

    rooms = client.get("/api/chat/rooms", headers=auth)
    assert rooms.status_code == 200
    assert any(r["id"] == "community" for r in rooms.get_json()), \
        "every account should land in the community room"
    sent = client.post("/api/chat/rooms/community/messages",
                       json={"text": "ci smoke"}, headers=auth)
    assert sent.status_code == 201, sent.get_data(as_text=True)

    for path in ("/api/me/interests", "/api/me/notifications",
                 "/api/me/submissions", "/api/app-reviews"):
        assert client.get(path, headers=auth).status_code == 200, path

print("Backend checks passed.")
PY
'
'''
            }
        }

        stage('Frontend build') {
            steps {
                sh '''#!/usr/bin/env bash
set -uo pipefail

# The build runs as root inside the container. Flutter writes outside build/
# too (.dart_tool, .flutter-plugins, caches), and anything left owned by root
# blocks both publishing and the workspace cleanup. This has to happen even
# when the build fails, otherwise the debris outlives this build and breaks
# the next one's checkout, turning one bad commit into a stuck pipeline.
reclaim() {
    docker run --rm \
        -v "${JENKINS_VOLUME}:/var/jenkins_home" \
        "${PYTHON_IMAGE}" \
        chown -R "$(id -u):$(id -g)" "${WORKSPACE}" || true
}
trap reclaim EXIT

# The API base URL is compiled in, so the deployed app calls its own domain
# instead of the localhost default used during development.
docker run --rm \
    --memory "${MEM_FLUTTER}" --memory-swap "${MEM_FLUTTER}" \
    -v "${JENKINS_VOLUME}:/var/jenkins_home" \
    -w "${WORKSPACE}/${APP_ROOT}" \
    -e PUB_CACHE=/var/jenkins_home/.pub-cache \
    "${FLUTTER_IMAGE}" \
    bash -c "
set -euo pipefail
git config --global --add safe.directory /sdks/flutter
git config --global --add safe.directory ${WORKSPACE}
flutter --version
flutter pub get
flutter analyze --no-fatal-infos
flutter test
flutter build web --release --base-href /app/ --dart-define=BACKEND_BASE_URL=https://${DOMAIN}
" || exit 1

test -f "${WORKSPACE}/${APP_ROOT}/build/web/index.html"
'''
            }
        }

        stage('Android package') {
            steps {
                // The web app is the primary artefact. A broken Android
                // toolchain should surface as UNSTABLE rather than block a
                // deployment that is otherwise good.
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    sh '''#!/usr/bin/env bash
set -uo pipefail

# Gradle and the Android SDK also write as root inside the container, and this
# stage is allowed to fail. Without an unconditional reclaim, a merely
# UNSTABLE build would still poison the next checkout, which is precisely how
# a failed APK in one build became a failed clone in the next.
reclaim() {
    docker run --rm \
        -v "${JENKINS_VOLUME}:/var/jenkins_home" \
        "${PYTHON_IMAGE}" \
        chown -R "$(id -u):$(id -g)" "${WORKSPACE}" || true
}
trap reclaim EXIT

log="${WORKSPACE}/android-build.log"

docker run --rm \
    --memory "${MEM_ANDROID}" --memory-swap "${MEM_ANDROID}" \
    -v "${JENKINS_VOLUME}:/var/jenkins_home" \
    -w "${WORKSPACE}/${APP_ROOT}" \
    -e PUB_CACHE=/var/jenkins_home/.pub-cache \
    -e GRADLE_USER_HOME=/var/jenkins_home/.gradle \
    "${FLUTTER_IMAGE}" \
    bash -c "
set -euo pipefail
git config --global --add safe.directory /sdks/flutter
git config --global --add safe.directory ${WORKSPACE}
yes | flutter doctor --android-licenses >/dev/null 2>&1 || true
flutter build apk --release --dart-define=BACKEND_BASE_URL=https://${DOMAIN}
" 2>&1 | tee "${log}"
status="${PIPESTATUS[0]}"

# Diagnosing this by exit code does not work. When the cgroup killer takes the
# Gradle daemon, Gradle reports a build failure and the Flutter wrapper exits
# 1, so the 137 that actually occurred never reaches this script. The daemon's
# own message is the only reliable signal, and it says nothing about memory,
# which is what made this fault expensive to identify the first time.
if [ "${status}" -ne 0 ] && grep -q 'daemon disappeared' "${log}" 2>/dev/null; then
    echo "" >&2
    echo "ERROR: the Gradle daemon was killed, almost certainly for exceeding" >&2
    echo "       the container ceiling of ${MEM_ANDROID}." >&2
    echo "" >&2
    echo "       This is a kill, not an OutOfMemoryError, so there is no heap" >&2
    echo "       dump and nothing in the daemon log explains it." >&2
    echo "" >&2
    echo "       The heaps in android/gradle.properties and MEM_ANDROID here" >&2
    echo "       are a matched pair. Remember that each JVM also costs several" >&2
    echo "       hundred megabytes of native overhead that -Xmx does not cover." >&2
    echo "" >&2
fi

rm -f "${log}"
[ "${status}" -eq 0 ] || exit "${status}"

test -f "${WORKSPACE}/${APP_ROOT}/build/app/outputs/flutter-apk/app-release.apk"
'''
                }
            }
        }

        stage('Build release image') {
            steps {
                // The frontend and backend are versioned together, which is
                // the whole reason they share a repository. Publishing the web
                // app before the backend image is known to build would break
                // exactly that guarantee: a failed backend left the new
                // frontend calling the old API. So the image is built and
                // proven first, and nothing user-visible moves until it is.
                sh '''#!/usr/bin/env bash
set -euo pipefail

# The signing key lives only on the server. Losing it would invalidate every
# issued token, so its absence is a hard failure rather than a regeneration.
test -f "${APP_DIR}/.env" || { echo "ERROR: ${APP_DIR}/.env is missing." >&2; exit 1; }

IMAGE_TAG="$(git rev-parse --short HEAD)"
export IMAGE_TAG

backup="${APP_DIR}/.rollback"
rm -rf "${backup}"
mkdir -p "${backup}"

# Keep the previous release so a failed health check can be reverted.
if [ -d "${APP_DIR}/site" ]; then
    cp -a "${APP_DIR}/site" "${backup}/site"
fi
if [ -d "${APP_DIR}/backend" ]; then
    cp -a "${APP_DIR}/backend" "${backup}/backend"
fi

# Recording the running image means a revert can re-point to a tag that is
# already built, instead of rebuilding from restored source. Rebuilding during
# a rollback asks the failing path to work twice, which is a poor bet when the
# deployment has just demonstrated it might not.
docker inspect -f '{{.Config.Image}}' globetrotter_backend 2>/dev/null \
    > "${backup}/image" || true

mkdir -p "${APP_DIR}/backend/data" "${APP_DIR}/nginx/conf.d"

# Staging the build context is safe at this point: the running container holds
# its own copy of the code from the image it was built from, so nothing here
# reaches production until the container is replaced further down.
rsync -a --delete --exclude '__pycache__' backend/app/ "${APP_DIR}/backend/app/"

install -m 0644 backend/requirements.txt "${APP_DIR}/backend/requirements.txt"
install -m 0755 backend/docker-entrypoint.sh "${APP_DIR}/backend/docker-entrypoint.sh"
install -m 0644 backend/data/destinations.json "${APP_DIR}/backend/data/destinations.json"

install -m 0644 "${APP_ROOT}/deploy/Dockerfile" "${APP_DIR}/Dockerfile"
install -m 0644 "${APP_ROOT}/deploy/docker-compose.yml" "${APP_DIR}/docker-compose.yml"
install -m 0644 "${APP_ROOT}/deploy/nginx/conf.d/globetrotter.conf" "${APP_DIR}/nginx/conf.d/globetrotter.conf"

# Housekeeping the post actions call. Installed here so it is present before
# any post block can run, including on a build that fails later on.
mkdir -p "${APP_DIR}/scripts"
install -m 0755 "${APP_ROOT}/deploy/scripts/retain-images.sh" "${APP_DIR}/scripts/retain-images.sh"

cd "${APP_DIR}"
docker compose build
echo "${IMAGE_TAG}" > "${APP_DIR}/.image-tag"

# Prove the image serves before it is allowed anywhere near live traffic. This
# runs detached from the compose project on a throwaway data directory, so a
# broken build is found here rather than by the first person to load the site.
docker rm -f kamergo_imagecheck >/dev/null 2>&1 || true
docker run -d --name kamergo_imagecheck \
    --memory 512m --memory-swap 512m \
    -e SECRET_KEY=image-smoke-test \
    "kamergo-backend:${IMAGE_TAG}" >/dev/null

ok=0
for _ in $(seq 1 30); do
    if docker exec kamergo_imagecheck python -c \
        "import urllib.request;urllib.request.urlopen('http://127.0.0.1:5000/healthz').read()" \
        >/dev/null 2>&1; then
        ok=1
        break
    fi
    sleep 2
done

if [ "${ok}" != "1" ]; then
    echo "ERROR: the newly built image never served /healthz." >&2
    docker logs --tail 50 kamergo_imagecheck >&2 || true
    docker rm -f kamergo_imagecheck >/dev/null 2>&1 || true
    exit 1
fi

docker rm -f kamergo_imagecheck >/dev/null 2>&1 || true
echo "Image kamergo-backend:${IMAGE_TAG} built and verified."
'''
            }
        }

        stage('Publish release') {
            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail

mkdir -p "${APP_DIR}/site/app" "${APP_DIR}/site/downloads" "${APP_DIR}/site/media"

# The document root is assembled here: landing page at the top level, the
# Flutter app under app/, release artefacts under downloads/. app/ and
# downloads/ are excluded from the landing sync so they survive it.
rsync -a --delete --exclude 'app/' --exclude 'downloads/' --exclude 'media/' \
    "${APP_ROOT}/landing/" "${APP_DIR}/site/"
rsync -a --delete "${APP_ROOT}/build/web/" "${APP_DIR}/site/app/"

# Stamp the shipped commit onto the app shell's bootstrap URL. See the comment
# in web/index.html for why this is necessary: without it a browser that has
# cached flutter_bootstrap.js keeps reading the previous service worker version
# and never learns a newer build exists.
RELEASE_ID="$(git rev-parse --short HEAD)"
sed -i "s|flutter_bootstrap.js?v=RELEASE_ID|flutter_bootstrap.js?v=${RELEASE_ID}|g" \
    "${APP_DIR}/site/app/index.html"

# A silent miss here would look like a successful deploy while every returning
# visitor stayed on the old app, so the token must be confirmed gone.
if grep -q 'flutter_bootstrap.js?v=RELEASE_ID' "${APP_DIR}/site/app/index.html"; then
    echo "Release stamp was not applied to the app shell." >&2
    grep -n 'flutter_bootstrap' "${APP_DIR}/site/app/index.html" >&2 || true
    exit 1
fi

if ! grep -q "flutter_bootstrap.js?v=${RELEASE_ID}" "${APP_DIR}/site/app/index.html"; then
    echo "App shell does not reference the bootstrap for ${RELEASE_ID}." >&2
    grep -n 'flutter_bootstrap' "${APP_DIR}/site/app/index.html" >&2 || true
    exit 1
fi

# The Flutter web build writes asset filenames percent-encoded on disk, which
# makes them unusable from plain HTML. The landing page therefore reads the
# photo library from media/, synced straight from source with names intact.
rsync -a --delete "${APP_ROOT}/assets/images/" "${APP_DIR}/site/media/"

# Published only when the Android stage produced one, so an UNSTABLE build
# keeps serving the previous APK instead of a broken link.
if [ -f "${APP_ROOT}/build/app/outputs/flutter-apk/app-release.apk" ]; then
    install -m 0644 "${APP_ROOT}/build/app/outputs/flutter-apk/app-release.apk" \
        "${APP_DIR}/site/downloads/kamer-go.apk"
fi
'''
            }
        }

        stage('Deploy and verify') {
            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail

# The image was built and proven in an earlier stage, so this starts a known
# good artefact rather than rebuilding and hoping. Compose reads IMAGE_TAG when
# resolving the service image.
IMAGE_TAG="$(cat "${APP_DIR}/.image-tag")"
export IMAGE_TAG

cd "${APP_DIR}"
docker compose up -d

# Jenkins runs in its own network namespace, so the host loopback that
# publishes ${APP_PORT} is unreachable from here. The container healthcheck
# is authoritative and is readable through the shared Docker socket.
ok=0
for _ in $(seq 1 45); do
    state=$(docker inspect -f '{{.State.Health.Status}}' globetrotter_backend 2>/dev/null || echo unknown)
    if [ "${state}" = "healthy" ]; then
        ok=1
        break
    fi
    sleep 2
done
if [ "${ok}" != "1" ]; then
    echo "ERROR: the backend never became healthy (last state: ${state})." >&2
    docker compose logs --tail 50 backend >&2 || true
    exit 1
fi

# Confirms the public routes are serving, not just the container.
curl -fsS "https://${DOMAIN}/" | grep -qi 'kamer-go'
curl -fsS -o /dev/null "https://${DOMAIN}/app/"
curl -fsS "https://${DOMAIN}/healthz" | grep -q '"status"'
count=$(curl -fsS "https://${DOMAIN}/api/destinations" | grep -o '"id"' | wc -l)
[ "${count}" -gt 0 ] || { echo "ERROR: the destination catalogue came back empty." >&2; exit 1; }
echo "Deployed successfully: ${count} destinations live at https://${DOMAIN}"
'''
            }
        }
    }

    post {
        failure {
            sh '''#!/usr/bin/env bash
set -uo pipefail

backup="${APP_DIR}/.rollback"
[ -d "${backup}" ] || exit 0

echo "Deployment failed; restoring the previous release."
[ -d "${backup}/site" ] && rsync -a --delete "${backup}/site/" "${APP_DIR}/site/"
[ -d "${backup}/backend" ] && rsync -a --delete "${backup}/backend/" "${APP_DIR}/backend/"

cd "${APP_DIR}"

# Restart from the image that was running before this build, which is already
# on disk. The previous version of this step rebuilt from restored source,
# which asked the very path that had just failed to succeed on the second
# attempt. Re-pointing at a known good tag has no such dependency.
#
# The recorded reference is re-tagged rather than parsed, so this works whether
# the prior release used the current naming scheme or the older Compose-derived
# name it replaced.
prev="$(cat "${backup}/image" 2>/dev/null || true)"
if [ -n "${prev}" ] && docker image inspect "${prev}" >/dev/null 2>&1; then
    echo "Reverting to ${prev}."
    docker tag "${prev}" kamergo-backend:rollback
    IMAGE_TAG=rollback docker compose up -d
else
    # No recorded image, or it has since been pruned. Rebuilding is the only
    # option left, and is reported plainly because it is the slower, less
    # certain path rather than the intended one.
    echo "No previous image available; rebuilding from the restored source." >&2
    IMAGE_TAG=rollback docker compose up -d --build
fi
'''
        }
        success {
            sh '''#!/usr/bin/env bash
set -uo pipefail

# Guarded because a build can reach here having failed before the publish
# stage installed this script. Housekeeping must never be the thing that
# decides a deployment's outcome.
rm -rf "${APP_DIR}/.rollback"
[ -x "${APP_DIR}/scripts/retain-images.sh" ] && "${APP_DIR}/scripts/retain-images.sh" || true
'''
        }
        unstable {
            // An unstable run still deployed and verified; only an optional
            // artefact was missing, so the snapshot has served its purpose and
            // the release image it produced needs retiring like any other.
            sh '''#!/usr/bin/env bash
set -uo pipefail

rm -rf "${APP_DIR}/.rollback"
[ -x "${APP_DIR}/scripts/retain-images.sh" ] && "${APP_DIR}/scripts/retain-images.sh" || true
'''
        }
        always {
            // deleteDir is a core step, so the workspace is still cleaned even
            // if the optional ws-cleanup plugin is unavailable. Housekeeping
            // must never decide the outcome of an otherwise good deployment,
            // so a stubborn leftover file is reported rather than thrown.
            catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
                // Jenkins deletes as its own user and cannot remove root-owned
                // files. A last reclaim means the cleanup actually succeeds
                // however the build ended, rather than silently leaving debris
                // for the next checkout to trip over.
                sh '''#!/usr/bin/env bash
set -uo pipefail

[ -d "${WORKSPACE}" ] || exit 0

docker run --rm \
    -v "${JENKINS_VOLUME}:/var/jenkins_home" \
    "${PYTHON_IMAGE}" \
    chown -R "$(id -u):$(id -g)" "${WORKSPACE}" || true
'''
                deleteDir()
            }
        }
    }
}
