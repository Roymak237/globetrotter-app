# Copy to .env and fill in. Never commit the real .env.

# Required. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

PORT=5000
FLASK_DEBUG=0

# Use APP_DOMAIN for a custom domain, or DUCKDNS_DOMAIN for a DuckDNS hostname.
APP_DOMAIN=
DUCKDNS_DOMAIN=globetrotter
DUCKDNS_TOKEN=your_duckdns_token_here
SSL_EMAIL=your_email@example.com

# --- Calls: the TURN media relay -------------------------------------------
#
# Leave this whole block empty and calls still negotiate; they will connect on
# ordinary broadband and fail silently on most mobile networks. Carrier-grade
# NAT, which nearly every Cameroonian mobile operator uses, gives each
# destination a different public mapping, so the address a phone learns from a
# STUN server is useless to the person it is calling. A relay fixes that by
# giving both sides one fixed address to send to.
#
# To turn it on:
#   1. Set COMPOSE_PROFILES=turn below. Compose reads this file for its own
#      settings, so the relay then starts with everything else.
#   2. Generate a password:
#        python -c "import secrets; print(secrets.token_urlsafe(24))"
#   3. Point TURN_URL at this host by name, not by IP — the certificate-free
#      TURN port does not care, but the address must stay valid after a
#      reboot gives the VPS a new address.
#   4. Open the ports on the host firewall. Nothing works without this:
#        ufw allow 3478/udp && ufw allow 3478/tcp
#        ufw allow 49160:49200/udp
#
# Verify afterwards with https://icetest.info — paste the URL, username and
# password, and look for a candidate of type "relay". If only "srflx" appears,
# the ports are still closed.
#
# If this VPS sits behind 1:1 NAT (its own `ip addr` does not show the public
# address), coturn additionally needs `--external-ip=PUBLIC/PRIVATE` adding to
# the command list in docker-compose.yml. On a VPS with a directly attached
# public address, which is the usual case, it detects this correctly on its own.
# COMPOSE_PROFILES=turn
COMPOSE_PROFILES=
# e.g. turn:kamer-go.duckdns.org:3478
TURN_URL=
TURN_USERNAME=kamergo
TURN_PASSWORD=
# Defaults to kamer-go.duckdns.org when left blank. Must match on both sides.
TURN_REALM=