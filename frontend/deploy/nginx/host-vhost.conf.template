# Host nginx virtual host for the GlobeTrotter web app.
#
# Installed into /etc/nginx/sites-available and symlinked into sites-enabled by
# scripts/deploy.sh. Certbot rewrites this file to add the TLS listener once a
# certificate has been issued, matching how the other sites on this box work.
#
# __DOMAIN__ and __APP_PORT__ are substituted at deploy time.
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # The call signalling socket needs the Upgrade handshake forwarded. It gets
    # its own location with a literal "upgrade" value rather than the usual
    # $connection_upgrade map, because that map has to be declared in the http
    # block and this file is dropped into a shared, certbot-managed nginx whose
    # http block is not ours to edit.
    location = /api/chat/ws {
        proxy_pass http://127.0.0.1:__APP_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # Requests are handed to the container nginx, which serves the Flutter build
    # and proxies /api to the backend.
    location / {
        proxy_pass http://127.0.0.1:__APP_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_connect_timeout 30s;
    }

    client_max_body_size 10M;
}
